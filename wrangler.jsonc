{
  "name": "overwatch-septic",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "observability": { "enabled": false },
  // Create these two in the Cloudflare dashboard (Storage & databases), then paste the D1 id below.
  "d1_databases": [{ "binding": "DB", "database_name": "overwatch-septic", "database_id": "eb5f7d34-dcd3-4d74-88c3-b6cfd7df1e06" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "overwatch-septic-files" }],
  "vars": {
    "MAIL_TO": "Joshua@overwatchseptic.com",
    "MAIL_FROM": "Overwatch Septic <Joshua@overwatchseptic.com>",
    "ACCESS_TEAM_DOMAIN": "REPLACE-your-team.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "ADMIN_EMAILS": "Joshua@overwatchseptic.com",
    "ALLOWED_ORIGINS": "https://overwatchseptic.com,https://www.overwatchseptic.com"
  }
}
